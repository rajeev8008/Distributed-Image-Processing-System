POSTGRES_DB=image_processing
POSTGRES_USER=image_app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://image_app@localhost:5432/image_processing
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TILE_TOPIC=tile-jobs
KAFKA_CONSUMER_GROUP=tile-workers
STORAGE_ROOT=storage
TILE_SIZE=512
MAX_UPLOAD_SIZE_MB=100
MAX_PROCESSING_ATTEMPTS=3
AGGREGATOR_INTERVAL_SECONDS=2
# WORKER_ID defaults to the container hostname.
